{
  "name": "token-parity",
  "version": "0.1.0",
  "description": "Check and sync design tokens between Figma variables and code.",
  "keywords": [
    "design-tokens",
    "figma",
    "figma-variables",
    "tailwind",
    "tailwindcss",
    "css-variables",
    "design-system",
    "claude-code"
  ],
  "author": "Andy Pyle",
  "license": "MIT",
  "homepage": "https://github.com/andypyle/token-parity#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andypyle/token-parity.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/andypyle/token-parity/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "token-parity": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "postcss": "^8.5.32"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^5.1.0"
  }
}
